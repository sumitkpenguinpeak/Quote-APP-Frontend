# Backend API base URL. Same domain as the app in production, so a relative path works.
VITE_API_BASE_URL=/api

# Shopify API key (client_id, public) - used by App Bridge in the embedded admin
VITE_SHOPIFY_API_KEY=

VITE_SUPPORT_CHAT_PROVIDER=
VITE_CRISP_WEBSITE_ID=
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
